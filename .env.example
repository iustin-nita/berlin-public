# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` — it is gitignored.

# --- Maps ---
# No token needed! The app uses MapLibre + OpenFreeMap (free, keyless,
# OpenStreetMap-based vector tiles). Nothing to configure here.

# --- Community features ---
# Public HTTPS Worker endpoint, not a database credential.
# See docs/community-backend.md for deployment instructions.
COMMUNITY_API_URL=https://your-worker.your-subdomain.workers.dev
