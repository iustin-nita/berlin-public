# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` — it is gitignored.

# --- Mapbox ---
# Public token (pk.*) — used by the Mapbox SDK at runtime. Safe to ship in the
# app binary, but restrict it by URL/scope in your Mapbox account dashboard.
# Create one at https://account.mapbox.com/access-tokens/
MAPBOX_PUBLIC_TOKEN=pk.your_public_token_here

# Secret download token (sk.*) — needed ONLY to download the native Mapbox SDK
# at build time. KEEP THIS SECRET. Never ship it in the app.
# Needs the DOWNLOADS:READ scope.
MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_download_token_here
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.your_secret_download_token_here

# --- Supabase (community features) ---
# Anon key is safe for the client ONLY when Row-Level Security is enabled.
# From your project: Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# --- Android (Google Maps, optional) ---
# Only required if you use Google Maps on Android. Restrict the key to your
# app's package name + SHA-1 in the Google Cloud console.
GOOGLE_MAPS_API_KEY_ANDROID=your_android_maps_key_here
