# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` — it is gitignored.

# --- Maps ---
# No token needed! The app uses MapLibre + OpenFreeMap (free, keyless,
# OpenStreetMap-based vector tiles). Nothing to configure here.

# --- Supabase (community features) ---
# Anon/publishable key is safe for the client ONLY when Row-Level Security is
# enabled. From your project: Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
