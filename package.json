{
  "name": "berlin-fountains",
  "version": "1.0.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:apk:debug": "cd android && ./gradlew assembleDebug",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:aab:debug": "cd android && ./gradlew bundleDebug",
    "install:apk": "adb install android/app/build/outputs/apk/release/app-release.apk",
    "install:apk:debug": "adb install android/app/build/outputs/apk/debug/app-debug.apk",
    "install:aab": "bundletool install-apks --apks=android/app/build/outputs/bundle/release/app-release.aab --device-id=$(adb devices | grep -v 'List of devices' | head -1 | cut -f1)",
    "deploy:apk": "npm run build:apk && npm run install:apk",
    "deploy:apk:debug": "npm run build:apk:debug && npm run install:apk:debug",
    "adb:devices": "adb devices",
    "adb:logcat": "adb logcat '*:S' ReactNative:V ReactNativeJS:V"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@gorhom/bottom-sheet": "^5.1.8",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.1.1",
    "@react-navigation/elements": "^2.2.3",
    "@react-navigation/native": "^7.0.12",
    "@react-navigation/native-stack": "^7.1.13",
    "@rnmapbox/maps": "^10.1.40",
    "@supabase/supabase-js": "^2.55.0",
    "expo": "^53.0.4",
    "expo-asset": "~11.1.4",
    "expo-clipboard": "~7.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-location": "~18.1.6",
    "expo-maps": "~0.11.0",
    "expo-splash-screen": "~0.30.7",
    "expo-system-ui": "~5.0.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "private": true
}
