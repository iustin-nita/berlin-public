{
  "name": "berlin-public",
  "version": "1.0.0",
  "description": "Find public fountains, restrooms, and essential amenities across Berlin. Works offline with community-driven updates.",
  "license": "MIT",
  "author": "Iustin Nita <contact@blobstudio.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/iustin-nita/berlin-toilets.git"
  },
  "keywords": [
    "expo",
    "react-native",
    "berlin",
    "mapbox",
    "fountains",
    "public-amenities",
    "open-data"
  ],
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "test": "jest",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --clean --platform android",
    "prebuild:ios": "expo prebuild --clean --platform ios",
    "build:apk": "npm run prebuild:android && cd android && ./gradlew assembleRelease",
    "build:apk:debug": "npm run prebuild:android && cd android && ./gradlew assembleDebug",
    "build:aab": "npm run prebuild:android && cd android && ./gradlew bundleRelease",
    "build:aab:debug": "npm run prebuild:android && cd android && ./gradlew bundleDebug",
    "install:apk": "adb install android/app/build/outputs/apk/release/app-release.apk",
    "install:apk:debug": "adb install android/app/build/outputs/apk/debug/app-debug.apk",
    "install:aab": "bundletool install-apks --apks=android/app/build/outputs/bundle/release/app-release.aab --device-id=$(adb devices | grep -v 'List of devices' | head -1 | cut -f1)",
    "deploy:apk": "npm run build:apk && npm run install:apk",
    "deploy:apk:debug": "npm run build:apk:debug && npm run install:apk:debug",
    "adb:devices": "adb devices",
    "adb:logcat": "adb logcat '*:S' ReactNative:V ReactNativeJS:V"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/metro-runtime": "~55.0.6",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@maplibre/maplibre-react-native": "^11.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.1.1",
    "@react-navigation/elements": "^2.2.3",
    "@react-navigation/native": "^7.0.12",
    "@react-navigation/native-stack": "^7.1.13",
    "@supabase/supabase-js": "^2.55.0",
    "expo": "^55.0.6",
    "expo-asset": "~55.0.10",
    "expo-clipboard": "~55.0.9",
    "expo-dev-client": "~55.0.18",
    "expo-haptics": "~55.0.9",
    "expo-location": "~55.1.4",
    "expo-maps": "~55.0.11",
    "expo-splash-screen": "~55.0.12",
    "expo-system-ui": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.1",
    "sonner-native": "^0.23.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
