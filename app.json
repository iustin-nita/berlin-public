{
  "expo": {
    "name": "Berlin Public",
    "slug": "berlin-public",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "berlinpublic",
    "description": "Find public fountains, restrooms, and essential amenities across Berlin. Works offline with community-driven updates.",
    "primaryColor": "#3B82F6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blobstudio.berlinpublic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.blobstudio.berlinpublic",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "sk.eyJ1IjoiaXVzdGlubiIsImEiOiJjbWUzeWxrbnkwYmphMmpzOTh1Z2p0dTAxIn0.itJMp15YV5sX8ZzcW2HRxg"
        }
      ],
      "react-native-edge-to-edge"
    ],
    "extra": {
      "mapboxPublicToken": "pk.eyJ1IjoiaXVzdGlubiIsImEiOiJjbTlpc2l3MjkwNHNsMmtzNjl3bG54dGNrIn0.HQ7d38Y6aQdteG-P3LODnw",
      "eas": {
        "projectId": "3b7bdd53-574d-4362-ae7c-6d9883b4dfca"
      }
    }
  }
}
