{
  "cli": {
    "version": ">= 15.0.10",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "prebuildCommand": "npx expo prebuild --clean --platform $EAS_BUILD_PLATFORM"
    }
  },
  "submit": {
    "production": {}
  }
}
